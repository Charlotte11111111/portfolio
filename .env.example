# 服务端密钥（不要用 VITE_ 前缀，否则会打进前端并触发浏览器 CORS）
# 本地：写入 .env.local
# 线上：Vercel → Settings → Environment Variables，然后 Redeploy
#
# Claude Code 对应关系:
#   ANTHROPIC_AUTH_TOKEN → LLM_API_KEY（也可直接填 ANTHROPIC_AUTH_TOKEN）
#   ANTHROPIC_BASE_URL   → LLM_API_BASE_URL
LLM_API_KEY=
LLM_API_BASE_URL=https://api.gotoken.top
LLM_MODEL=MiniMax-M2
