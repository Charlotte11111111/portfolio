# Anthropic 兼容网关（与 Claude Code settings.json 对应）
# 本地：复制为 .env.local 并填入真实值（勿提交 Git / 勿写进 .env.example）
# 线上：Vercel → Settings → Environment Variables 配置同名变量后 Redeploy
#
# Claude Code:
#   ANTHROPIC_AUTH_TOKEN  → VITE_LLM_API_KEY
#   ANTHROPIC_BASE_URL    → VITE_LLM_API_BASE_URL
VITE_LLM_API_KEY=
VITE_LLM_API_BASE_URL=https://api.gotoken.top
VITE_LLM_MODEL=MiniMax-M2
